{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "REP Report",
  "scopeName": "source.rep",
  "fileTypes": ["rep"],
  "patterns": [
    { "include": "#subject" },
    { "include": "#group" },
    { "include": "#tag" },
    { "include": "#tabular-name" },
    { "include": "#tabular-value" },
    { "include": "#decorator" },
    { "include": "#level-threshold" },
    { "include": "#item-title" }
  ],
  "repository": {

    "subject": {
      "match": "^(SBJ)(\\. )(.+?)( //.+)?$",
      "captures": {
        "1": { "name": "keyword.control.subject.rep" },
        "2": { "name": "punctuation.separator.rep" },
        "3": { "name": "entity.name.section.rep" },
        "4": { "name": "comment.line.rep" }
      }
    },

    "group": {
      "match": "^( *)(GRP)(\\. )(.+?)( //.+)?$",
      "captures": {
        "2": { "name": "keyword.control.group.rep" },
        "3": { "name": "punctuation.separator.rep" },
        "4": { "name": "entity.name.class.rep" },
        "5": { "name": "comment.line.rep" }
      }
    },

    "tag": {
      "match": "^( *)(#) (.+)$",
      "captures": {
        "2": { "name": "punctuation.definition.tag.rep" },
        "3": { "name": "entity.name.tag.rep" }
      }
    },

    "tabular-name": {
      "match": "^( *)(-) (.+?)( //.+)?$",
      "captures": {
        "2": { "name": "punctuation.definition.variable.rep" },
        "3": { "name": "variable.other.tabular.rep" },
        "4": { "name": "comment.line.rep" }
      }
    },

    "tabular-value": {
      "begin": "^( *)(;) ((DAT|YER|DTR|DTT|DMR)|(TIM|TMR)|(TXT|DSC|REF|UID|TAG)|(INT|NUM|GTI|GTN|PPI|PPN|RGI|RGN)|(MSI|MSN|MSX|PCI|PCN|PCX|ERN)|(PRG|CMP|BOL)|(RAT|PRI|TSK)|(LVI|LVN|LVO|LVS|LVE|LVP|LVC|REL)|(NON|UNK|XXX)|([A-Z]+))(\\.)(  ?)",
      "end": "$",
      "beginCaptures": {
        "2":  { "name": "punctuation.definition.tabular.rep" },
        "4":  { "name": "support.type.date.rep" },
        "5":  { "name": "support.type.time.rep" },
        "6":  { "name": "support.type.text.rep" },
        "7":  { "name": "support.type.number.rep" },
        "8":  { "name": "support.type.measure.rep" },
        "9":  { "name": "support.type.progress.rep" },
        "10": { "name": "support.type.rating.rep" },
        "11": { "name": "support.type.level.rep" },
        "12": { "name": "support.type.unknown.rep" },
        "13": { "name": "invalid.illegal.type.rep" },
        "14": { "name": "punctuation.separator.rep" }
      },
      "patterns": [{ "include": "#value-content" }]
    },

    "decorator": {
      "begin": "^( *)(:) ((DAT|YER|DTR|DTT|DMR)|(TIM|TMR)|(TXT|DSC|REF|UID|TAG)|(INT|NUM|GTI|GTN|PPI|PPN|RGI|RGN)|(MSI|MSN|MSX|PCI|PCN|PCX|ERN)|(PRG|CMP|BOL)|(RAT|PRI|TSK)|(LVI|LVN|LVO|LVS|LVE|LVP|LVC|REL)|(NON|UNK|XXX)|([A-Z]+))(\\.)(  ?)",
      "end": "$",
      "beginCaptures": {
        "2":  { "name": "punctuation.definition.decorator.rep" },
        "4":  { "name": "support.type.date.rep" },
        "5":  { "name": "support.type.time.rep" },
        "6":  { "name": "support.type.text.rep" },
        "7":  { "name": "support.type.number.rep" },
        "8":  { "name": "support.type.measure.rep" },
        "9":  { "name": "support.type.progress.rep" },
        "10": { "name": "support.type.rating.rep" },
        "11": { "name": "support.type.level.rep" },
        "12": { "name": "support.type.unknown.rep" },
        "13": { "name": "invalid.illegal.type.rep" },
        "14": { "name": "punctuation.separator.rep" }
      },
      "patterns": [{ "include": "#value-content" }]
    },

    "level-threshold": {
      "begin": "^( *)(>>>)( )",
      "end": "$",
      "beginCaptures": {
        "2": { "name": "keyword.operator.level.rep" }
      },
      "patterns": [{ "include": "#value-content" }]
    },

    "item-title": {
      "match": "^( +)(?!GRP\\. |- |; |: |# |>>>)(.+)$",
      "captures": {
        "2": { "name": "entity.name.rep" }
      }
    },

    "value-content": {
      "patterns": [
        { "include": "#value-date" },
        { "include": "#value-time" },
        { "include": "#value-progress" },
        { "include": "#value-boolean" },
        { "include": "#value-relation" },
        { "include": "#value-number" },
        { "include": "#value-path-sep" },
        { "include": "#value-text" }
      ]
    },

    "value-date": {
      "match": "<[^>]+>",
      "name": "constant.other.date.rep"
    },

    "value-time": {
      "match": "\\b\\d{1,4}:\\d{2}(:\\d{2})?\\b",
      "name": "constant.numeric.time.rep"
    },

    "value-progress": {
      "match": "\\b(DONE|TODO|DOING)\\b",
      "name": "constant.language.progress.rep"
    },

    "value-boolean": {
      "match": "\\b(TRUE|FALSE|YES|NO|true|false)\\b",
      "name": "constant.language.boolean.rep"
    },

    "value-relation": {
      "match": "^[><=](?= )",
      "name": "keyword.operator.relation.rep"
    },

    "value-number": {
      "match": "-?\\b\\d+(\\.\\d+)?%?\\b",
      "name": "constant.numeric.rep"
    },

    "value-path-sep": {
      "match": "::",
      "name": "punctuation.separator.path.rep"
    },

    "value-text": {
      "match": "\\S+",
      "name": "string.unquoted.text.rep"
    }

  }
}
